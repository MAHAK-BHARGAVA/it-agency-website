generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Service {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String   @db.Text
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceCities     ServiceCity[]
  serviceStates     ServiceState[]
  serviceIndustries ServiceIndustry[]
  portfolios        Portfolio[]   @relation("PortfolioServices")
  testimonials      Testimonial[] @relation("TestimonialServices")
  faqs              Faq[]         @relation("FaqServices")
  leads             Lead[]
}

model City {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  stateId         Int?
  state           State?   @relation(fields: [stateId], references: [id])
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceCities ServiceCity[]
  testimonials  Testimonial[] @relation("TestimonialCities")
  faqs          Faq[]         @relation("FaqCities")
}

model State {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cities        City[]
  serviceStates ServiceState[]
  faqs          Faq[] @relation("FaqStates")
}

model Industry {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String   @db.Text
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceIndustries ServiceIndustry[]
  portfolios        Portfolio[]   @relation("PortfolioIndustries")
  testimonials      Testimonial[] @relation("TestimonialIndustries")
  faqs              Faq[]         @relation("FaqIndustries")
}

model ServiceCity {
  id          Int      @id @default(autoincrement())
  service     Service  @relation(fields: [serviceId], references: [id])
  serviceId   Int
  city        City     @relation(fields: [cityId], references: [id])
  cityId      Int
  heroHeading String?
  introText   String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([serviceId, cityId])
}

model ServiceState {
  id          Int      @id @default(autoincrement())
  service     Service  @relation(fields: [serviceId], references: [id])
  serviceId   Int
  state       State    @relation(fields: [stateId], references: [id])
  stateId     Int
  heroHeading String?
  introText   String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([serviceId, stateId])
}

model ServiceIndustry {
  id          Int      @id @default(autoincrement())
  service     Service  @relation(fields: [serviceId], references: [id])
  serviceId   Int
  industry    Industry @relation(fields: [industryId], references: [id])
  industryId  Int
  heroHeading String?
  introText   String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([serviceId, industryId])
}

model Blog {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @db.Text
  category        String?
  featuredImage   String?
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Portfolio {
  id            Int      @id @default(autoincrement())
  projectName   String
  slug          String   @unique
  thumbnail     String?
  resultSummary String   @db.Text
  clientName    String?
  projectUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services   Service[]  @relation("PortfolioServices")
  industries Industry[] @relation("PortfolioIndustries")
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  clientName String
  company    String?
  quote      String   @db.Text
  rating     Int?
  photo      String?
  createdAt  DateTime @default(now())

  services   Service[]  @relation("TestimonialServices")
  cities     City[]     @relation("TestimonialCities")
  industries Industry[] @relation("TestimonialIndustries")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())

  services   Service[]  @relation("FaqServices")
  cities     City[]     @relation("FaqCities")
  states     State[]    @relation("FaqStates")
  industries Industry[] @relation("FaqIndustries")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  service   Service? @relation(fields: [serviceId], references: [id])
  serviceId Int?
  city      String?
  message   String   @db.Text
  createdAt DateTime @default(now())
}