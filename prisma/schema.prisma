generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Service {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String   @db.Text
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceCities     ServiceCity[]
  serviceStates     ServiceState[]
  serviceIndustries ServiceIndustry[]
  portfolios        Portfolio[]   @relation("PortfolioServices")
  testimonials      Testimonial[] @relation("TestimonialServices")
  faqs              Faq[]         @relation("FaqServices")
  leads             Lead[]
}

model City {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  stateId         Int?
  state           State?   @relation(fields: [stateId], references: [id])
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceCities ServiceCity[]
  testimonials  Testimonial[] @relation("TestimonialCities")
  faqs          Faq[]         @relation("FaqCities")
}

model State {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cities        City[]
  serviceStates ServiceState[]
  faqs          Faq[] @relation("FaqStates")
}

model Industry {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String   @db.Text
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  serviceIndustries ServiceIndustry[]
  portfolios        Portfolio[]   @relation("PortfolioIndustries")
  testimonials      Testimonial[] @relation("TestimonialIndustries")
  faqs              Faq[]         @relation("FaqIndustries")
}

model ServiceCity {
  id          Int      @id @default(autoincrement())
  service     Service  @relation(fields: [serviceId], references: [id],onDelete: Cascade)
  serviceId   Int
  city        City     @relation(fields: [cityId], references: [id])
  cityId      Int
  metaTitle       String?
  metaDescription String?
  heroHeading String?
  introText   String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([serviceId, cityId])
  
}

model ServiceState {
  id          Int      @id @default(autoincrement())
  service     Service  @relation(fields: [serviceId], references: [id],onDelete: Cascade)
  serviceId   Int
  state       State    @relation(fields: [stateId], references: [id])
  stateId     Int
  heroHeading String?
  introText   String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([serviceId, stateId])
}

model ServiceIndustry {
  id          Int      @id @default(autoincrement())
  service     Service  @relation(fields: [serviceId], references: [id],onDelete: Cascade)
  serviceId   Int
  industry    Industry @relation(fields: [industryId], references: [id])
  industryId  Int
  heroHeading String?
  introText   String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([serviceId, industryId])
}

model Blog {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @db.Text
  category        String?
  featuredImage   String?
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Portfolio {
  id            Int      @id @default(autoincrement())
  projectName   String
  slug          String   @unique
  thumbnail     String?
  resultSummary String   @db.Text
  clientName    String?
  projectUrl    String?
  challenge     String?  @db.Text
  solution      String?  @db.Text
  process       String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  services    Service[]     @relation("PortfolioServices")
  industries  Industry[]    @relation("PortfolioIndustries")
  testimonial Testimonial?  @relation(fields: [testimonialId], references: [id])
  testimonialId Int?        @unique
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  clientName String
  company    String?
  quote      String   @db.Text
  rating     Int?
  photo      String?
  createdAt  DateTime @default(now())

  services   Service[]  @relation("TestimonialServices")
  cities     City[]     @relation("TestimonialCities")
  industries Industry[] @relation("TestimonialIndustries")
  portfolio Portfolio?
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  createdAt DateTime @default(now())

  services   Service[]  @relation("FaqServices")
  cities     City[]     @relation("FaqCities")
  states     State[]    @relation("FaqStates")
  industries Industry[] @relation("FaqIndustries")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin")

  refreshTokens  RefreshToken[]
  assignedLeads  Lead[]         @relation("AssignedLeads")
  leadActivities LeadActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  SPAM
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadActivityType {
  LEAD_CREATED
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_UPDATED
  CALL
  EMAIL
  WHATSAPP
  MEETING
  FOLLOW_UP
  PROPOSAL_SENT
}

model Lead {
  id                   Int          @id @default(autoincrement())
  name                 String
  email                String?
  phone                String

  serviceId            Int?
  service              Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  city                 String?
  message              String?      @db.Text
  preferredStartTime   String?
  source               String?      @default("website")

  status               LeadStatus   @default(NEW)
  priority             LeadPriority @default(MEDIUM)

  notes                String?      @db.Text
  estimatedValue       Decimal?     @db.Decimal(12, 2)
  nextFollowUpAt       DateTime?
  lostReason           String?

 assignedToId Int?
assignedTo   User? @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)

  activities           LeadActivity[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @default(now()) @updatedAt

  @@index([status])
  @@index([serviceId])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
  @@index([createdAt])
  @@map("leads")
}

model LeadActivity {
  id Int @id @default(autoincrement())

  leadId Int
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type        LeadActivityType
  title       String
  description String?          @db.Text

  oldStatus LeadStatus?
  newStatus LeadStatus?

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdById])
  @@index([createdAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id Int @id @default(1)

  companyName String

  logo      String
  whiteLogo String?
  favicon   String?

  phone   String
  email   String
  address String

  facebook  String?
  instagram String?
  linkedin  String?
  twitter   String?
  youtube   String?

  salesEmail   String?
  seoEmail     String?
  aiEmail      String?
  supportEmail String?
  mediaEmail   String?

  footerCopyright String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeHero {
  id Int @id @default(1)

  badge String

  title String

  description String @db.Text

  primaryButtonText String
  primaryButtonLink String

  secondaryButtonText String?
  secondaryButtonLink String?

  heroImage String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeAbout {
  id Int @id @default(1)

  sectionTitle String

  title String

  description String @db.Text

  experience Int

  image String

  featureOne String

  featureTwo String

  featureThree String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}