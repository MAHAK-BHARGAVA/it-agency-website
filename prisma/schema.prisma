generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Service {
  id                Int               @id @default(autoincrement())
  name              String
  slug              String            @unique
  description       String            @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  canonicalUrl      String?
  metaDescription   String?
  metaTitle         String?
  ogImage           String?
  image             String?
  serviceCities     ServiceCity[]
  serviceIndustries ServiceIndustry[]
  serviceStates     ServiceState[]
  leads             Lead[]
  faqs              Faq[]             @relation("FaqServices")
  portfolios        Portfolio[]       @relation("PortfolioServices")
  testimonials      Testimonial[]     @relation("TestimonialServices")
}

model City {
  id              Int           @id @default(autoincrement())
  name            String
  slug            String        @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  canonicalUrl    String?
  metaDescription String?
  metaTitle       String?
  ogImage         String?
  stateId         Int?
  state           State?        @relation(fields: [stateId], references: [id])
  serviceCities   ServiceCity[]
  faqs            Faq[]         @relation("FaqCities")
  testimonials    Testimonial[] @relation("TestimonialCities")

  @@index([stateId], map: "City_stateId_fkey")
}

model State {
  id              Int            @id @default(autoincrement())
  name            String
  slug            String         @unique
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  cities          City[]
  serviceStates   ServiceState[]
  faqs            Faq[]          @relation("FaqStates")
}

model Industry {
  id                Int               @id @default(autoincrement())
  name              String
  slug              String            @unique
  description       String            @db.Text
  metaTitle         String?
  metaDescription   String?
  canonicalUrl      String?
  ogImage           String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  serviceIndustries ServiceIndustry[]
  faqs              Faq[]             @relation("FaqIndustries")
  portfolios        Portfolio[]       @relation("PortfolioIndustries")
  testimonials      Testimonial[]     @relation("TestimonialIndustries")
}

model ServiceCity {
  id              Int      @id @default(autoincrement())
  serviceId       Int
  cityId          Int
  heroHeading     String?
  introText       String?  @db.Text
  createdAt       DateTime @default(now())
  metaDescription String?
  metaTitle       String?
  city            City     @relation(fields: [cityId], references: [id])
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, cityId])
  @@index([cityId], map: "ServiceCity_cityId_fkey")
}

model ServiceState {
  id              Int      @id @default(autoincrement())
  serviceId       Int
  stateId         Int
  heroHeading     String?
  introText       String?  @db.Text
  createdAt       DateTime @default(now())
  metaTitle       String?
  metaDescription String?
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  state           State    @relation(fields: [stateId], references: [id])

  @@unique([serviceId, stateId])
  @@index([stateId], map: "ServiceState_stateId_fkey")
}

model ServiceIndustry {
  id              Int      @id @default(autoincrement())
  serviceId       Int
  industryId      Int
  heroHeading     String?
  introText       String?  @db.Text
  createdAt       DateTime @default(now())
  metaTitle       String?
  metaDescription String?
  industry        Industry @relation(fields: [industryId], references: [id])
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, industryId])
  @@index([industryId], map: "ServiceIndustry_industryId_fkey")
}

model Blog {
  id              Int       @id @default(autoincrement())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String    @db.Text
  category        String?
  featuredImage   String?
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Portfolio {
  id            Int          @id @default(autoincrement())
  projectName   String
  slug          String       @unique
  thumbnail     String?
  resultSummary String       @db.Text
  clientName    String?
  projectUrl    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  challenge     String?      @db.Text
  process       String?      @db.Text
  solution      String?      @db.Text
  testimonialId Int?         @unique
  testimonial   Testimonial? @relation(fields: [testimonialId], references: [id])
  industries    Industry[]   @relation("PortfolioIndustries")
  services      Service[]    @relation("PortfolioServices")
}

model Testimonial {
  id         Int        @id @default(autoincrement())
  clientName String
  company    String?
  quote      String     @db.Text
  rating     Int?
  photo      String?
  createdAt  DateTime   @default(now())
  portfolio  Portfolio?
  cities     City[]     @relation("TestimonialCities")
  industries Industry[] @relation("TestimonialIndustries")
  services   Service[]  @relation("TestimonialServices")
}

model Faq {
  id         Int        @id @default(autoincrement())
  question   String
  answer     String     @db.Text
  createdAt  DateTime   @default(now())
  cities     City[]     @relation("FaqCities")
  industries Industry[] @relation("FaqIndustries")
  services   Service[]  @relation("FaqServices")
  states     State[]    @relation("FaqStates")
}

model User {
  id               Int            @id @default(autoincrement())
  email            String         @unique
  password         String
  name             String?
  role             String         @default("admin")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  leadActivities   LeadActivity[]
  createdFollowUps LeadFollowUp[]
  refreshTokens    RefreshToken[]
  assignedLeads    Lead[]         @relation("AssignedLeads")
}

model Lead {
  id                 Int            @id @default(autoincrement())
  name               String
  email              String?
  phone              String
  serviceId          Int?
  city               String?
  message            String?        @db.Text
  preferredStartTime String?
  source             String?        @default("website")
  createdAt          DateTime       @default(now())
  notes              String?        @db.Text
  status             LeadStatus     @default(NEW)
  updatedAt          DateTime       @default(now()) @updatedAt
  assignedToId       Int?
  estimatedValue     Decimal?       @db.Decimal(12, 2)
  lostReason         String?
  nextFollowUpAt     DateTime?
  priority           LeadPriority   @default(MEDIUM)
  activities         LeadActivity[]
  followUps          LeadFollowUp[]
  assignedTo         User?          @relation("AssignedLeads", fields: [assignedToId], references: [id])
  service            Service?       @relation(fields: [serviceId], references: [id])

  @@index([status])
  @@index([serviceId])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
  @@index([createdAt])
  @@map("leads")
}

model LeadActivity {
  id          Int              @id @default(autoincrement())
  leadId      Int
  type        LeadActivityType
  title       String
  description String?          @db.Text
  oldStatus   LeadStatus?
  newStatus   LeadStatus?
  createdById Int?
  createdAt   DateTime         @default(now())
  createdBy   User?            @relation(fields: [createdById], references: [id])
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdById])
  @@index([createdAt])
}

model LeadFollowUp {
  id          Int            @id @default(autoincrement())
  leadId      Int
  title       String
  description String?        @db.Text
  scheduledAt DateTime
  status      FollowUpStatus @default(PENDING)
  completedAt DateTime?
  createdById Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  createdBy   User?          @relation(fields: [createdById], references: [id])
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdById])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "RefreshToken_userId_fkey")
}

model SiteSetting {
  id              Int      @id @default(1)
  companyName     String
  logo            String
  whiteLogo       String?
  favicon         String?
  phone           String
  email           String
  address         String
  facebook        String?
  instagram       String?
  linkedin        String?
  twitter         String?
  youtube         String?
  footerCopyright String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  aiEmail         String?
  mediaEmail      String?
  salesEmail      String?
  seoEmail        String?
  supportEmail    String?
}

model HomeHero {
  id                  Int      @id @default(1)
  badge               String
  title               String
  description         String   @db.Text
  primaryButtonText   String
  primaryButtonLink   String
  secondaryButtonText String?
  secondaryButtonLink String?
  heroImage           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model HomeAbout {
  id           Int      @id @default(1)
  sectionTitle String
  title        String
  description  String   @db.Text
  experience   Int
  image        String
  featureOne   String
  featureTwo   String
  featureThree String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  SPAM
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeadActivityType {
  LEAD_CREATED
  STATUS_CHANGED
  NOTE_ADDED
  NOTE_UPDATED
  CALL
  EMAIL
  WHATSAPP
  MEETING
  FOLLOW_UP
  PROPOSAL_SENT
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}